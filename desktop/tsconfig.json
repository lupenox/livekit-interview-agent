{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "types": ["node", "electron", "electron-squirrel-startup"]
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "forge.config.ts", "vite.*.config.ts"]
}
