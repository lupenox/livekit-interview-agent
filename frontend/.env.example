LIVEKIT_URL=wss://your-livekit-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Server-only provider keys used by the in-interview API budget monitor.
# Never prefix these values with NEXT_PUBLIC_.
ELEVENLABS_API_KEY=your_elevenlabs_api_key
DEEPGRAM_API_KEY=your_deepgram_api_key
GROQ_API_KEY=your_groq_api_key

# Optional when the Deepgram key can access more than one project.
DEEPGRAM_PROJECT_ID=

# Optional Deepgram balance warning thresholds (default: 5 and 1).
DEEPGRAM_LOW_BALANCE=5
DEEPGRAM_CRITICAL_BALANCE=1
